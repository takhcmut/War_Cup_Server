# Copy this file to src/main/resources/env.properties for local development.
# For Atlas, set MONGODB_URL to your mongodb+srv connection string.

# MongoDB Atlas or local MongoDB URI.
# Local example:
# MONGODB_URL=mongodb://localhost:27017/warcup
# Atlas example:
# MONGODB_URL=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/warcup?retryWrites=true&w=majority&appName=WarCup
MONGODB_URL=mongodb://localhost:27017/warcup
MONGODB_DB_NAME=warcup

# Redis local defaults.
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT defaults for local development.
JWT_SECRET=dev-secret-change-me
JWT_VALID_DURATION=3600
JWT_REFRESH_DURATION=86400

# Bind addresses and ports.
SPRING_SERVER_ADDRESS=0.0.0.0
SPRING_SERVER_PORT=8080
NETTY_SERVER_ADDRESS=0.0.0.0
NETTY_SERVER_PORT=8386